# =============================================================================
# .zshrc — managed by dotter (repo: ~/.dotfiles/zsh/zshrc)
# Plugin management: antidote (https://antidote.sh)
#   bundles are listed in ~/.zsh_plugins.txt (repo: zsh/zsh_plugins.txt)
# Prompt: starship (replaces the omz theme, which starship already overrode)
# =============================================================================

# ---- locale / editor -------------------------------------------------------
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export EDITOR='nvim'

# ---- PATH ------------------------------------------------------------------
export PNPM_HOME="$HOME/Library/pnpm"
export PATH="$PNPM_HOME:$PATH"
export PATH="$PATH:$HOME/.cargo/bin"
export PATH="$HOME/.local/bin:$PATH"

# ---- history ----------------------------------------------------------------
HISTSIZE=100000
SAVEHIST=50000

setopt extended_history       # record timestamp of command in HISTFILE
setopt hist_expire_dups_first # delete duplicates first when HISTFILE size exceeds HISTSIZE
setopt hist_ignore_dups       # ignore duplicated commands history list
setopt hist_ignore_space      # ignore commands that start with space
setopt hist_verify            # show command with history expansion to user before running it
setopt share_history          # share command history data

# ---- antidote --------------------------------------------------------------
# Install with: brew install antidote
#   or: git clone --depth=1 https://github.com/mattmc3/antidote.git ${ZDOTDIR:-$HOME}/.antidote
if [[ -f $HOMEBREW_PREFIX/opt/antidote/share/antidote/antidote.zsh ]]; then
    source $HOMEBREW_PREFIX/opt/antidote/share/antidote/antidote.zsh
elif [[ -f ${ZDOTDIR:-$HOME}/.antidote/antidote.zsh ]]; then
    source ${ZDOTDIR:-$HOME}/.antidote/antidote.zsh
fi

# initialize plugins statically with ${ZDOTDIR:-$HOME}/.zsh_plugins.txt
antidote load

# ---- completion ------------------------------------------------------------
autoload -Uz compinit
compinit

# ---- vi mode (replaces the omz vi-mode plugin) -----------------------------
bindkey -v
KEYTIMEOUT=20  # 200ms;

autoload -Uz add-zle-hook-widget edit-command-line
zle -N edit-command-line

_dotfiles_vi_keymap_select() {
  case $KEYMAP in
    vicmd|visual)
      printf '\e[2 q'  # steady block
      ;;
    viins|main)
      printf '\e[6 q'  # steady bar
      ;;
  esac
}

_dotfiles_vi_line_init() {
  zle -K viins
  printf '\e[6 q'
}

_dotfiles_vi_line_finish() {
  printf '\e[6 q'
}

add-zle-hook-widget zle-keymap-select _dotfiles_vi_keymap_select
add-zle-hook-widget zle-line-init      _dotfiles_vi_line_init
add-zle-hook-widget zle-line-finish    _dotfiles_vi_line_finish

# Keybindings previously provided by the omz vi-mode plugin
bindkey -M vicmd 'vv' edit-command-line    # vv: edit the command line in $EDITOR

bindkey -M viins '^P' up-history
bindkey -M viins '^N' down-history
bindkey -M viins '^A' beginning-of-line
bindkey -M viins '^E' end-of-line
bindkey -M viins '^F' forward-char
bindkey -M viins '^B' backward-char

# ---- aliases ---------------------------------------------------------------
alias g='git'
alias gst='git status'
alias gp='git push'
alias gpf='git push --force-with-lease --force-if-includes'
alias gl='git pull'
alias gaa='git add --all'
alias gco='git checkout'
alias gd='git diff'
alias gcm='git commit -m'
alias glog='git log --oneline --decorate --graph'
alias gfa='git fetch --all --prune'
alias gbgD='LANG=C git branch --no-color -vv | grep ": gone\]" | cut -c 3- | awk '"'"'{print $1}'"'"' | xargs git branch -D'

alias ra=yazi
alias v=nvim
alias lg=lazygit
alias yt-dlp-de="yt-dlp -S 'res:720' --merge-output-format mkv --write-subs --write-auto-subs --sub-langs de,deu,de-DE,zh"  # https://github.com/yt-dlp/yt-dlp/issues/630#issuecomment-893659460
alias mpv-de="mpv --secondary-sid=auto --secondary-sub-pos=90"

# ---- tools -----------------------------------------------------------------
eval "$(zoxide init zsh)"
eval "$(fzf --zsh)"   # fzf >= 0.48; replaces the omz fzf plugin and ~/.fzf.zsh
eval "$(starship init zsh)"

# ---- work ------------------------------------------------------------------
if [ -f "$HOME/work.sh" ]; then
    source "$HOME/work.sh"
fi
